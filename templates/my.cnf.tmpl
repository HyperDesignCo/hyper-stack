[client]
port = {{.Port}}
host = 127.0.0.1

[mysqld]
basedir = {{.BaseDir}}
datadir = {{.DataDir}}
port = {{.Port}}
bind-address = 127.0.0.1
{{if .Socket}}socket = {{.Socket}}
{{end}}mysqlx = OFF
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
innodb_buffer_pool_size = 256M
max_allowed_packet = 64M
log_error = {{.LogFile}}
# sql_mode: MySQL 8 default (not overridden)
